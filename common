# 7. Características, escalado y reporte comparativo
# ----------------------------------------------------------------------------------------
def standardize(rec, sc):
    """Estandariza con media/desv. del ENTRENAMIENTO (scaler.pkl) -> sin fuga de información."""
    return (rec["feats"] - sc["mu"]) / sc["sd"]


def window_features(Xs, W=30):
    """Características por ventana causal de W muestras (5 min a 0.1 Hz) para IF / RF."""
    b = Xs[:, 0]
    pad = np.concatenate([np.full(W - 1, b[0]), b])
    win = np.lib.stride_tricks.sliding_window_view(pad, W)
    return np.stack([np.abs(win).max(1), win.std(1), np.abs(np.diff(win, axis=1)).mean(1),
                     Xs[:, 1], Xs[:, 2], Xs[:, 3]], axis=1)


def roc_curve(test_recs, test_scores, m, n_thr=50):
    """Barrido de umbral: (alarmas falsas por hora, recall de eventos). Solo para graficar."""
    mx = np.array([persistence(s, m).max() for s in test_scores])
    grid = np.unique(np.quantile(mx, np.linspace(0, 1, n_thr)))
    far, rec = [], []
    for th in grid:
        met = evaluate(test_recs, test_scores, th, m)
        far.append(met["far_por_hora"])
        rec.append(met["recall"])
    return np.array(far), np.array(rec)


def reporte(scores, test_recs, m=6, q=0.99, verbose=True):
    """scores[metodo] = dict(val=[arrays normales de validación], test=[arrays de prueba]).
    Calibra θ en validación, evalúa en prueba y arma la tabla comparativa."""
    res = {}
    for name, sc in scores.items():
        th = calibrate_threshold(sc["val"], m, q)
        met = evaluate(test_recs, sc["test"], th, m)
        amps, p, mda = detection_vs_amp(met)
        res[name] = dict(theta=th, metrics=met, amps=amps, p=p, mda=mda,
                         roc=roc_curve(test_recs, sc["test"], m))
    if verbose:
        print(f"\n{'método':<14}{'F1':>6}{'prec':>7}{'recall':>8}{'FNR crít.':>10}{'FP':>4}"
              f"{'FAR/h':>8}{'MDA[cm]':>9}{'retardo[min]':>13}{'holgura[min]':>13}")
        for name, r in res.items():
            k = r["metrics"]
            print(f"{name:<14}{k['f1']:6.2f}{k['precision']:7.2f}{k['recall']:8.2f}"
                  f"{k['fnr_critico']:10.2f}{k['fp']:4d}{k['far_por_hora']:8.3f}"
                  f"{r['mda'] * 100:9.1f}{k['retardo_med_s'] / 60:13.1f}{k['holgura_med_s'] / 60:13.1f}")
        h = next(iter(res.values()))["metrics"]["horas_normal"]
        print(f"\nHoras de mar normal evaluadas: {h:.1f} h.  Si FP=0, regla de tres (IC95 %): "
              f"FAR <= {3 / h:.3f} /h.  F1 a nivel de registro; MDA = menor amplitud con P(det) >= 90 %.")
    return res
