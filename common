from scipy.signal import butter, sosfilt, sosfilt_zi, lfilter

# ----------------------------------------------------------------------------------------
# 0. Constantes globales
# ----------------------------------------------------------------------------------------
G = 9.81
FS = 2.0                       # Hz - tasa del filtro de fusión (IMU a 2 Hz, GNSS a 1 Hz) [SUPUESTO]
DT = 1.0 / FS
DUR_MIN = 180                  # duración de cada registro [min]
WARMUP_MIN = 40                # transitorio de filtros causales; se descarta
DEC = 20                       # decimación 2 Hz -> 0.1 Hz
FS_D = FS / DEC                # 0.1 Hz
N_SAMPLES = int(DUR_MIN * 60 * FS)
N_WARM_D = int(WARMUP_MIN * 60 * FS_D)          # muestras decimadas a descartar
N_D = int(DUR_MIN * 60 * FS_D) - N_WARM_D       # muestras decimadas útiles por registro
A_CRIT = 0.10                  # [m] amplitud en la boya que define el "conjunto crítico" [SUPUESTO]

FEATURES = ["banda_tsunami", "rms_oleaje", "viento", "presion"]


# ----------------------------------------------------------------------------------------
# 1. Batimetría y tsunami 1D (ecuaciones lineales de aguas someras)
# ----------------------------------------------------------------------------------------
_BAT_AVISO = False


def bathymetry(x_km, scale=1.0):
    """Perfil de profundidad h(x) [m]; x = distancia a la costa [km].
    global _BAT_AVISO
    for ruta in ("perfil_arica.csv", os.path.join(os.path.dirname(os.path.abspath(__file__)), "perfil_arica.csv")):
        if os.path.exists(ruta):                                  # transecto real (00_extraer_batimetria.py)
            P = np.loadtxt(ruta, delimiter=",", skiprows=1)
            if not _BAT_AVISO:
                print(f"[batimetria] USANDO transecto real: {os.path.abspath(ruta)} (0-{P[-1, 0]:.0f} km)"); _BAT_AVISO = True
            return scale * np.interp(x_km, P[:, 0], P[:, 1])
    if not _BAT_AVISO:
        print("[batimetria] AVISO: no se encontro perfil_arica.csv -> usando perfil de EJEMPLO (no real)"); _BAT_AVISO = True
    xp = np.array([0, 5, 10, 30, 60, 100, 150, 200, 250], dtype=float)
    hp = np.array([10, 100, 200, 1500, 3000, 4500, 6000, 7500, 7500], dtype=float)
    return scale * np.interp(x_km, xp, hp)


def swe_1d(xu, wu, xs, ws, d_buoy_km, t_sim_s=5400.0, dx=500.0, dt=0.5, bath_scale=1.0,
           x_coast_ref_km=2.5):
    """Resuelve  d(eta)/dt = -dq/dx ;  dq/dt = -g h d(eta)/dx   (q = h u)  con esquema
    'forward-backward' en malla escalonada.   Condición de borde: pared en la costa (x=0) y
    radiación en el borde mar adentro (x=300 km).

    Fuente tipo dipolo de subducción: levantamiento (centro xu, ancho wu) + subsidencia
    (centro xs, ancho ws), en km desde la costa.
    Devuelve eta en la boya y en un punto de referencia costero (h~50 m), a FS = 2 Hz, con
    amplitud unitaria (el modelo es lineal: se reescala después)."""
    L = 300e3                                # dominio 0-300 km (borde absorbente lejos de la boya)
    n = int(L / dx)
    xc = (np.arange(n) + 0.5) * dx          # centros (eta)
    xf = np.arange(n + 1) * dx              # caras (q)
    hf = np.maximum(bathymetry(xf / 1e3, bath_scale), 5.0)
    c_max = np.sqrt(G * hf.max())
    assert dt <= dx / c_max, "CFL violada: reduce dt o aumenta dx"   # estabilidad numérica

    x_km = xc / 1e3
    eta = np.exp(-((x_km - xu) / wu) ** 2) - 0.6 * np.exp(-((x_km - xs) / ws) ** 2)
    q = np.zeros(n + 1)
    ib = int(d_buoy_km * 1e3 / dx)
    ic = int(x_coast_ref_km * 1e3 / dx)
    steps = int(t_sim_s / dt)
    out_b = np.empty(steps)
    out_c = np.empty(steps)
    gdt_dx = G * dt / dx
    for k in range(steps):
        q[1:n] -= gdt_dx * hf[1:n] * (eta[1:] - eta[:-1])
        q[n] = eta[-1] * np.sqrt(G * hf[n])         # radiación saliente (mar adentro)
        eta -= (dt / dx) * (q[1:] - q[:-1])
        out_b[k] = eta[ib]
        out_c[k] = eta[ic]
    return out_b, out_c


# ----------------------------------------------------------------------------------------
# 2. Mar normal: JONSWAP + marea
# ----------------------------------------------------------------------------------------
def jonswap_heave(hs, tp, n, fs, rng, gamma=3.3):
    """Serie temporal de elevación del oleaje (heave) con espectro JONSWAP escalado a Hs, Tp.
    Devuelve (z, a): elevación [m] y aceleración vertical [m/s^2] exactas."""
    f = np.arange(0.04, 0.50, 0.002)
    fp = 1.0 / tp
    sig = np.where(f <= fp, 0.07, 0.09)
    r = np.exp(-((f - fp) ** 2) / (2 * sig ** 2 * fp ** 2))
    S = f ** -5 * np.exp(-1.25 * (fp / f) ** 4) * gamma ** r
    m0 = np.sum(S) * 0.002
    S *= (hs / 4.0) ** 2 / m0                       # Hs = 4 sqrt(m0)
    amp = np.sqrt(2 * S * 0.002)
    ph = rng.uniform(0, 2 * np.pi, f.size)
    t = np.arange(n) / fs
    arg = 2 * np.pi * np.outer(t, f) + ph
    z = np.cos(arg) @ amp
    a = -(np.cos(arg) @ (amp * (2 * np.pi * f) ** 2))
    return z, a


def tide(n, fs, rng):
    t = np.arange(n) / fs
    return (0.6 * np.cos(2 * np.pi * t / (12.42 * 3600) + rng.uniform(0, 6.28))
            + 0.2 * np.cos(2 * np.pi * t / (12.00 * 3600) + rng.uniform(0, 6.28)))


# ----------------------------------------------------------------------------------------
# 3. Sensores: GNSS e IMU
# ----------------------------------------------------------------------------------------
def gnss_noise(n, fs, hs, rng, sig_white=0.03, sig_gm=0.02, tau=600.0):
    """Error vertical GNSS RT-PPP: ruido blanco (aumenta con el estado del mar por multipath)
    + proceso Gauss-Markov de correlación tau (errores de órbita/reloj, convergencia)."""
    w = rng.normal(0, sig_white * (1 + 0.15 * hs), n)
    phi = np.exp(-1.0 / (fs * tau))
    gm = lfilter([np.sqrt(1 - phi ** 2) * sig_gm], [1, -phi], rng.normal(size=n))
    return w + gm


def imu_accel(a_true, rng, sig_a=0.02, bias_sd=0.02):
    return a_true + rng.normal(0, bias_sd) + rng.normal(0, sig_a, a_true.size)


def _kalman_gains(sig_a=0.02, q_bias=1e-7, r=0.04 ** 2, iters=3000):
    """Ganancia de Kalman en régimen permanente (3 estados: z, v, sesgo; GNSS cada 2 muestras)."""
    F = np.array([[1, DT, -0.5 * DT ** 2], [0, 1, -DT], [0, 0, 1.0]])
    Gm = np.array([[0.5 * DT ** 2], [DT], [0.0]])
    Q = sig_a ** 2 * (Gm @ Gm.T) + np.diag([0, 0, q_bias * DT])
    H = np.array([[1.0, 0, 0]])
    P = np.diag([1.0, 1.0, 0.1])
    K = None
    for k in range(iters):
        P = F @ P @ F.T + Q
        if k % 2 == 0:                               # actualización GNSS a 1 Hz
            S = H @ P @ H.T + r
            K = (P @ H.T / S).ravel()
            P = (np.eye(3) - np.outer(K, H)) @ P
    return K


_K = _kalman_gains()


def kalman_fusion(z_gnss, a_imu):
    """Fusión GNSS-IMU vertical (filtro de Kalman lineal de ganancia constante).
    NOTA: en el informe se declara un EKF de 6 GDL; aquí se valida el canal vertical (heave),
    que es el único que mide el nivel del mar. Es una versión lineal (equivale a un EKF)."""
    n = z_gnss.size
    out = np.empty(n)
    x0, x1, x2 = z_gnss[0], 0.0, 0.0
    k0, k1, k2 = _K
    dt2 = 0.5 * DT * DT
    a_prev = a_imu[0]
    for i in range(n):
        # integración trapezoidal: usa la aceleración media del intervalo (con la del inicio
        # el filtro queda "adelantado" medio paso y el error crece con el oleaje)
        acc = 0.5 * (a_prev + a_imu[i]) - x2
        a_prev = a_imu[i]
        x0 += x1 * DT + acc * dt2
        x1 += acc * DT
        if i % 2 == 0:
            innov = z_gnss[i] - x0
            x0 += k0 * innov
            x1 += k1 * innov
            x2 += k2 * innov
        out[i] = x0
    return out


