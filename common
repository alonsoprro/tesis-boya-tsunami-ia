# 4. Estados del mar (NDBC si existen archivos; si no, distribución sintética)
# ----------------------------------------------------------------------------------------
def load_ndbc_stdmet(path):
    """Lee un archivo histórico NDBC 'stdmet' (.txt o .txt.gz), formato nuevo (2007+, con minutos y 4 dígitos
    de año) o antiguo (YY de 2 dígitos, columna BAR en vez de PRES, sin minutos). Devuelve DataFrame con
    YY, MM, WSPD [m/s], WVHT [m], DPD [s], PRES [hPa] (faltantes -> NaN)."""
    import gzip, io
    op = gzip.open if str(path).endswith(".gz") else open
    with op(path, "rt", encoding="utf-8", errors="ignore") as f:
        lines = [l.strip() for l in f if l.strip()]
    ih = next(k for k, l in enumerate(lines) if "WVHT" in l)               # línea de encabezado
    names = lines[ih].lstrip("#").split()
    rows = [l.split() for l in lines[ih + 1:] if l.split()[0].isdigit()]   # descarta la línea de unidades
    df = pd.DataFrame([r[:len(names)] for r in rows], columns=names)
    df = df.rename(columns={"YYYY": "YY", "BAR": "PRES", "WD": "WDIR"})
    for c_ in ("YY", "MM", "WSPD", "WVHT", "DPD", "PRES"):
        df[c_] = pd.to_numeric(df[c_], errors="coerce")
    df["YY"] = np.where(df["YY"] < 100, df["YY"] + np.where(df["YY"] > 70, 1900, 2000), df["YY"])
    for c_, bad in [("WSPD", 99.0), ("WVHT", 99.0), ("DPD", 99.0), ("PRES", 9999.0)]:
        df.loc[df[c_] >= bad, c_] = np.nan
    return df[["YY", "MM", "WSPD", "WVHT", "DPD", "PRES"]].dropna()


class SeaStatePool:
    """Entrega estados del mar (hs, tp, viento, presión) por año.
    Con archivos NDBC en data/ndbc/*.txt(.gz) usa datos reales; si no, distribución sintética
    [SUPUESTO] equivalente (marejadas de hasta ~6 m)."""

    def __init__(self, ndbc_dir="data/ndbc"):
        self.df = None
        if os.path.isdir(ndbc_dir):
            files = [os.path.join(ndbc_dir, f) for f in os.listdir(ndbc_dir)
                     if f.endswith((".txt", ".gz"))]
            if files:
                self.df = pd.concat([load_ndbc_stdmet(f) for f in files], ignore_index=True)
                print(f"[SeaStatePool] NDBC real: {len(self.df)} registros, "
                      f"años {sorted(self.df.YY.unique())}")
        if self.df is None:
            print("[SeaStatePool] Sin archivos NDBC -> estados del mar SINTÉTICOS")

    def sample(self, rng, year):
        if self.df is not None:
            sub = self.df[self.df.YY == year]
            if len(sub) > 0:
                r = sub.iloc[rng.integers(len(sub))]
                return (float(np.clip(r.WVHT, 0.3, 8.0)), float(np.clip(r.DPD, 5, 20)),
                        float(r.WSPD), float(r.PRES))
        hs = float(np.clip(rng.lognormal(np.log(1.8), 0.45), 0.4, 7.0))
        tp = float(np.clip(rng.normal(11 + 0.4 * hs, 2), 6, 19))
        wind = float(max(1.0, 3 + 2.5 * hs + rng.normal(0, 1.5)))
        pres = float(1015 - 1.5 * (hs - 1.8) + rng.normal(0, 2))
        return hs, tp, wind, pres


# ----------------------------------------------------------------------------------------
# 5. Generación de un registro (normal o con tsunami)
# ----------------------------------------------------------------------------------------
SOS_BP = butter(4, [1 / 3600, 1 / 120], btype="band", fs=FS, output="sos")
SOS_LP30 = butter(2, 1 / 30, btype="low", fs=FS, output="sos")


def make_record(rng, pool, year, amp=None, d_buoy=150, sig_gm=0.02, sig_white=0.03,
                bath_scale=1.0, return_raw=False, src=None, eta_ext=None, t0_ext=3900.0):
    """Genera un registro de 180 min. amp=None -> normal; amp>0 -> tsunami cuya amplitud pico
    en la boya es `amp` [m]. Devuelve dict con características decimadas (sin warm-up),
    etiqueta por muestra y tiempos de referencia."""
    n = N_SAMPLES
    hs, tp, wind, pres = pool.sample(rng, year)
    zw, aw = jonswap_heave(hs, tp, n, FS, rng)
    z_tide = tide(n, FS, rng)
    z_true = zw + z_tide
    a_true = aw
    t_b = t_coast = t0 = None
    if amp is not None:
        if src is None:
            xu = rng.uniform(80, 150)
            src = dict(xu=xu, wu=rng.uniform(15, 40), xs=xu - rng.uniform(40, 70),
                       ws=rng.uniform(25, 50))
        eb, ec = swe_1d(src["xu"], src["wu"], src["xs"], src["ws"], d_buoy, bath_scale=bath_scale)
        k = amp / np.max(np.abs(eb))                      # modelo lineal -> reescalado exacto
        eb, ec = eb * k, ec * k
        t0 = rng.uniform(60, 80) * 60.0
        i0 = int(t0 * FS)
        m = min(len(eb), n - i0)
        eta = np.zeros(n)
        eta[i0:i0 + m] = eb[:m]
        eta[i0 + m:] = eb[m - 1]
        z_true = z_true + eta
        # Llegada = primer instante en que la señal CAMBIA respecto a su estado inicial (la deformación inicial de la
        # fuente puede ya cubrir la costa en t=0; eso no es la llegada de la onda).
        db, dc = eb - eb[0], ec - ec[0]
        tb_idx = np.argmax(np.abs(db) >= 0.01)
        tc_idx = np.argmax(np.abs(dc) >= 0.10 * np.max(np.abs(dc)))
        t_b = t0 + tb_idx / FS                           # llegada a la boya (|eta| >= 1 cm)
        t_coast = t0 + tc_idx / FS                       # llegada a la costa (10 % del máximo)

    if eta_ext is not None:                              # señal de tsunami REAL (p. ej. DART) a FS, sin marea
        i0 = int(t0_ext * FS)
        m = min(len(eta_ext), n - i0)
        eta = np.zeros(n)
        eta[i0:i0 + m] = eta_ext[:m]
        eta[i0 + m:] = eta_ext[m - 1]
        z_true = z_true + eta
        t0, t_coast, amp = t0_ext, np.nan, float(np.max(np.abs(eta_ext)))
        t_b = t0_ext + int(np.argmax(np.abs(eta_ext) >= 0.01)) / FS

    z_gnss = z_true + gnss_noise(n, FS, hs, rng, sig_white=sig_white, sig_gm=sig_gm)
    a_imu = imu_accel(a_true, rng)
    z_fus = kalman_fusion(z_gnss, a_imu)

    # Estado inicial de los filtros = régimen permanente sobre el nivel lento (marea). Un sistema
    # real ya lleva horas operando; arrancar con estado cero (o con la 1ª muestra, que incluye
    # la elevación instantánea del oleaje) crea un transitorio escalón que no es tsunami.
    lvl0 = z_tide[0]
    band = sosfilt(SOS_BP, z_fus, zi=sosfilt_zi(SOS_BP) * lvl0)[0]
    wave = z_fus - sosfilt(SOS_LP30, z_fus, zi=sosfilt_zi(SOS_LP30) * lvl0)[0]
    wrms = np.sqrt(lfilter(np.ones(1200) / 1200, [1], wave ** 2))   # RMS móvil 10 min (causal)
    band_d, wrms_d = band[::DEC], wrms[::DEC]
    nd = band_d.size
    wind_d = wind + np.cumsum(rng.normal(0, 0.02, nd))
    pres_d = (pres - 1013) + np.cumsum(rng.normal(0, 0.01, nd))
    feats = np.stack([band_d, wrms_d, wind_d, pres_d], axis=1)[N_WARM_D:]

    t_d = (np.arange(nd) / FS_D)[N_WARM_D:]
    label = np.zeros(feats.shape[0], dtype=int)
    if t_b is not None:
        label[t_d >= t_b] = 1
    rec = dict(feats=feats, label=label, t=t_d, t_b=t_b, t_coast=t_coast, t0=t0, amp=amp,
               hs=hs, d_buoy=d_buoy, year=year, kind="normal" if amp is None else "event")
    if return_raw:
        rec["raw"] = dict(z_true=z_true, z_gnss=z_gnss, z_fus=z_fus, a_true=a_true)
    return rec


# ----------------------------------------------------------------------------------------
# 6. Utilidades de modelos / evaluación
# ----------------------------------------------------------------------------------------
def persistence(score, m):
    """Exige m muestras consecutivas sobre el umbral (mínimo móvil causal)."""
    if m <= 1:
        return score
    pad = np.concatenate([np.full(m - 1, -np.inf), score])
    w = np.lib.stride_tricks.sliding_window_view(pad, m)
    return w.min(axis=1)


def first_alarm(score, theta, m):
    sp = persistence(score, m)
    idx = np.flatnonzero(sp > theta)
    return int(idx[0]) if idx.size else None


def calibrate_threshold(scores_normal, m, quantile=0.99):
    """Umbral = cuantil de los máximos (con persistencia) de los registros normales de validación."""
    mx = [persistence(s, m).max() for s in scores_normal]
    return float(np.quantile(mx, quantile))


def evaluate(recs, scores, theta, m):
    """Métricas a nivel de registro. Primera alarma antes de la llegada a la boya = falsa alarma;
    después = detección. Devuelve dict con precision, recall, F1, FNR, FAR, retardo y holgura."""
    tp = fp = fn = tn = 0
    rows = []
    hours_normal = 0.0
    for rec, s in zip(recs, scores):
        ia = first_alarm(s, theta, m)
        t_alarm = None if ia is None else rec["t"][ia]
        if rec["kind"] == "normal":
            hours_normal += (rec["t"][-1] - rec["t"][0]) / 3600
            if ia is None:
                tn += 1
            else:
                fp += 1
        else:
            if ia is None:
                fn += 1
                rows.append((rec["amp"], 0, np.nan, np.nan))
            elif t_alarm < rec["t_b"]:
                fp += 1
                rows.append((rec["amp"], 0, np.nan, np.nan))
            else:
                tp += 1
                rows.append((rec["amp"], 1, t_alarm - rec["t_b"], rec["t_coast"] - t_alarm))
    prec = tp / (tp + fp) if tp + fp else np.nan
    n_ev = sum(1 for r in recs if r["kind"] == "event")
    recall = tp / n_ev if n_ev else np.nan
    f1 = 2 * prec * recall / (prec + recall) if prec and recall and (prec + recall) > 0 else 0.0
    det = np.array([r for r in rows if r[1] == 1])
    crit = [r for r in rows if r[0] >= A_CRIT]
    fnr_crit = np.mean([1 - r[1] for r in crit]) if crit else np.nan
    return dict(precision=prec, recall=recall, f1=f1, fnr=1 - recall if n_ev else np.nan,
                fnr_critico=fnr_crit, fp=fp, tn=tn, tp=tp, n_events=n_ev,
                far_por_hora=fp / hours_normal if hours_normal else np.nan,
                horas_normal=hours_normal,
                retardo_med_s=float(np.nanmedian(det[:, 2])) if det.size else np.nan,
                holgura_med_s=float(np.nanmedian(det[:, 3])) if det.size else np.nan,
                filas=rows)


def detection_vs_amp(metrics):
    """Probabilidad de detección por amplitud y amplitud mínima detectable (>=90 %)."""
    rows = np.array(metrics["filas"], dtype=float)
    amps = np.unique(rows[:, 0])
    p = [rows[rows[:, 0] == a, 1].mean() for a in amps]
    ok = [a for a, pp in zip(amps, p) if pp >= 0.9]
    return amps, np.array(p), (min(ok) if ok else np.nan)


def save(obj, path):
    with open(path, "wb") as f:
        pickle.dump(obj, f)


def load(path):
    with open(path, "rb") as f:
        return pickle.load(f)


